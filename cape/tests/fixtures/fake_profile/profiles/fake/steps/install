#!/usr/bin/env python3
import json
import os

guest = json.load(open(os.environ["TT_GUEST_JSON"]))
print("STEP Installing")
print("PROGRESS 20")
print(f"LOG account={guest['identity']['account']} password={guest['identity']['password']}")
print(f"LOG token={guest['options']['token']}")
with open(os.path.join(os.environ["TT_GUEST_DIR"], "ran"), "a") as ran:
    ran.write(os.environ["TT_STEP"] + "\n")
