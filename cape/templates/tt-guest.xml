<!-- No <forward>: libvirt treats the network as isolated and rejects routed traffic in and out of
     the bridge; CAPE's rooter opens exactly what a task's route needs. DNS is off so INetSim can
     own port 53 on the gateway. libvirt's own dhcp-option=3 hides the router on isolated
     networks; the dnsmasq options below re-advertise the gateway, so guest traffic reaches the
     rooter's DNAT rules instead of having no route at all. The lease outlives a typical run because
     the rooter's inetsim route DNATs the guest's unicast DHCP renewals away from dnsmasq. -->
<network xmlns:dnsmasq='http://libvirt.org/schemas/network/dnsmasq/1.0'>
  <name>tt-guest</name>
  <bridge name='tt-guest' stp='off' delay='0'/>
  <dns enable='no'/>
  <ip address='${GUEST_GATEWAY_IP}' netmask='255.255.255.0'>
    <dhcp>
      <range start='${GUEST_IP}' end='${GUEST_IP}'>
        <lease expiry='10' unit='minutes'/>
      </range>
    </dhcp>
  </ip>
  <dnsmasq:options>
    <dnsmasq:option value='dhcp-option=option:router,${GUEST_GATEWAY_IP}'/>
    <dnsmasq:option value='dhcp-option=option:dns-server,${GUEST_GATEWAY_IP}'/>
  </dnsmasq:options>
</network>
