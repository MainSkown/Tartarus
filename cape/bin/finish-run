#!/usr/bin/python3
"""Ends a running analysis early. The one operation: POST /tasks/<task id>/finish.

CAPE's analyzer in the guest stops the analysis as soon as a folder named md5("cape-<task id>")
exists in %TMP% or %SystemRoot%\\Temp (analyzer/windows/analyzer.py, analysis_loop). The guest
network exists only inside this container, so the backend cannot reach the guest agent that can
create that folder; this service can, and listens on the internal network for the backend instead.

It serves the one guest at GUEST_AGENT_URL, and stays as it is until the backend switches to
`guest-control`, which finishes a run on the guest the request names.

Environment: CAPE_INTERNAL_IP (required), FINISH_RUN_PORT (8001), GUEST_AGENT_URL
(http://192.168.150.10:8000), FINISH_RUN_AGENT_TIMEOUT in seconds (5).
"""

import os
import sys

# `python3 -I` does not put the script's directory on the path, and the helpers sit next to it.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import control_http
from finish_logic import completion_folder, finish_response  # noqa: F401 - completion_folder is part of the tested surface

DEFAULT_PORT = 8001
DEFAULT_AGENT_URL = "http://192.168.150.10:8000"
DEFAULT_AGENT_TIMEOUT_SECONDS = 5.0
GUEST_TEMP_DIRECTORY = "C:\\Windows\\Temp"


def make_routes(agent_url: str, agent_timeout: float) -> list[control_http.Route]:
    def finish(request: control_http.Request) -> control_http.Answer:
        def destination() -> tuple[str, str]:
            return agent_url, GUEST_TEMP_DIRECTORY

        return finish_response(request.arguments["task_id"], destination, agent_timeout)

    return [control_http.Route("POST", r"/tasks/(?P<task_id>[^/]*)/finish", finish)]


def main() -> None:
    address = os.environ.get("CAPE_INTERNAL_IP")
    if not address:
        sys.exit("finish-run: CAPE_INTERNAL_IP must be set")
    port = int(os.environ.get("FINISH_RUN_PORT", DEFAULT_PORT))
    agent_url = os.environ.get("GUEST_AGENT_URL", DEFAULT_AGENT_URL).rstrip("/")
    agent_timeout = float(os.environ.get("FINISH_RUN_AGENT_TIMEOUT", DEFAULT_AGENT_TIMEOUT_SECONDS))
    # A method the one route does not take has always been answered 404 here.
    handler = control_http.make_handler(
        make_routes(agent_url, agent_timeout), service="finish-run", wrong_method_status=404
    )
    server = control_http.make_server(address, port, handler)
    control_http.log("finish-run", f"listening on {address}:{port}, guest agent at {agent_url}")
    server.serve_forever()


if __name__ == "__main__":
    main()
