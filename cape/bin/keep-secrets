#!/usr/bin/env bash
# Usage: keep-secrets [SECRET_NAME...] -- <command> [args...]
# Runs the command with every secret of the container's environment removed except the named ones.
# supervisord gives each child the whole environment it started with; every program starts through this
# so a compromised parser reads only what its own program needs (cape/supervisord.conf lists them).
set -euo pipefail

SECRETS=(CAPE_API_TOKEN CAPE_DB_PASSWORD GUEST_CONTROL_TOKEN)

usage() { echo "usage: keep-secrets [${SECRETS[*]}]... -- <command> [args...]" >&2; exit 2; }

is_secret() {
    local candidate
    for candidate in "${SECRETS[@]}"; do [[ $candidate == "$1" ]] && return 0; done
    return 1
}

kept=()
while (($#)) && [[ $1 != -- ]]; do
    is_secret "$1" || usage
    kept+=("$1")
    shift
done
(($#)) || usage
shift
(($#)) || usage

for secret in "${SECRETS[@]}"; do
    [[ " ${kept[*]:-} " == *" $secret "* ]] || unset "$secret"
done
exec "$@"
