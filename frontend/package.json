{
  "name": "tartarus-frontend",
  "productName": "Tartarus",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "Tartarus malware analysis GUI",
  "type": "module",
  "engines": {
    "node": "^24 || ^26",
    "npm": ">= 10"
  },
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build -m pwa",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "quasar prepare && vue-tsc --noEmit",
    "test:unit": "vitest run",
    "api:sync": "openapi-ts -i http://localhost:8000/openapi.json -o ./src/api -c @hey-api/client-fetch",
    "screenshots": "playwright test -c playwright.config.ts tests/screenshots",
    "e2e": "playwright test -c playwright.e2e.config.ts"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "cytoscape": "3.34.4",
    "cytoscape-dagre": "4.0.1",
    "guacamole-common-js": "1.5.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/guacamole-common-js": "1.5.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "sass-embedded": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "workbox-build": "^7.4.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
