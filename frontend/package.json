{
  "name": "tartarus-frontend",
  "productName": "Tartarus",
  "version": "0.0.1",
  "private": true,
  "description": "Tartarus malware analysis GUI",
  "type": "module",
  "engines": {
    "node": "^24 || ^26",
    "npm": ">= 10"
  },
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build -m pwa",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "quasar prepare && vue-tsc --noEmit",
    "test:unit": "vitest run",
    "api:sync": "openapi-ts -i http://localhost:8000/openapi.json -o ./src/api -c @hey-api/client-fetch",
    "screenshots": "playwright test -c playwright.config.ts tests/screenshots"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.0.3",
    "quasar": "^2.35.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.0",
    "@quasar/app-vite": "^3.10.2",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13",
    "workbox-build": "^7.4.1"
  }
}
