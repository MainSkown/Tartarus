# Copy to .env and adjust. Secrets are generated into data/secrets.env on first start.

# Compose
COMPOSE_PROJECT_NAME=tartarus
TARTARUS_PORT=8080
TZ=UTC

# PostgreSQL (used from the foundation phase).
# Passwords end up inside a database URL: use letters, digits, "-", "_" and "." only.
POSTGRES_USER=tartarus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tartarus

# CAPE database, created by the postgres init script (CAPE uses it from M0)
CAPE_DB_USER=cape
CAPE_DB_PASSWORD=change-me-too
CAPE_DB_NAME=cape

# OpenSearch (used from the foundation phase)
OPENSEARCH_HEAP=1536m

# Backend (used from the foundation phase)
LOG_LEVEL=info

# CAPE and guest (used from M0)
# CAPE_REF pins kevoreilly/CAPEv2 to a full commit SHA; empty uses the pin in docker-compose.yml.
CAPE_REF=
# The backend's apiv2 token. Required: compose refuses to start the stack without one, and the
# cape container registers it with CAPE on start. Generate it with: openssl rand -hex 32
CAPE_API_TOKEN=
# The bearer token of the guest control service in the cape container, which only the backend may
# call (over the tartarus-control network). Required. Generate it with: openssl rand -hex 32
GUEST_CONTROL_TOKEN=
# The CAPE machine label the backend submits to and checks for in its health; it must match the
# label scripts/build-guest.sh registered (the same variable is read there).
GUEST_LABEL=win
# The Windows guest (scripts/build-guest.sh reads the GUEST_* settings from here).
# GUEST_ISO is a file in data/iso/; GUEST_IMAGE_INDEX selects the edition in its install.wim
# (5 = Windows 11 Pro on Microsoft's retail ISOs).
GUEST_ISO=Win11_25H2_Polish_x64_v2.iso
GUEST_IMAGE_INDEX=5
GUEST_VCPUS=2
GUEST_RAM_MB=4096
GUEST_DISK_GB=80
# The guest bridge tt-guest. Must be a /24: the gateway is .1, guests have static addresses from .10
# to .99 and the DHCP pool a cold-booting guest draws from is .100 to .119.
GUEST_SUBNET=192.168.150.0/24

# Analysis defaults and disk guards (used from M1)
DEFAULT_ROUTE=inetsim
DEFAULT_TIMEOUT=180
DISK_WARN_GB=50
DISK_BLOCK_GB=20
