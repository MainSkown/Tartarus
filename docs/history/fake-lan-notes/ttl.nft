table ip tartarus_lanspike_ttl
delete table ip tartarus_lanspike_ttl
table ip tartarus_lanspike_ttl {
  set fake_hosts { type ipv4_addr; elements = { 192.168.150.200, 192.168.150.201 } }
  chain out {
    type route hook output priority -150; policy accept;
    oifname "tt-guest" ip saddr @fake_hosts ip ttl set 128 counter
  }
}
