#!/usr/bin/env bash
# Removes the optical drives the installation left in Windows, which a running guest does not have
# any more but whose device entries a sample can still read (decision 6). The profile runs it as
# agent.pre_snapshot, after the agent answers and before the clean snapshot. Idempotent.
set -uo pipefail
# shellcheck source=lib/windows.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/windows.sh"

GHOST_DRIVES_TIMEOUT_S=120

step "Removing the leftover optical drives"
progress 5
output=$(guest_agent run remove-ghost-drives.ps1 --timeout "$GHOST_DRIVES_TIMEOUT_S")
code=$?
[[ -z $output ]] || printf '%s\n' "$output"
case $code in
    0) log "remove-ghost-drives.ps1: $(result_summary "$output")" ;;
    70) fail "the guest agent could not be used to run remove-ghost-drives.ps1" ;;
    71) fail "remove-ghost-drives.ps1 reported no exit code" ;;
    *) fail "remove-ghost-drives.ps1 ended with exit code $code" ;;
esac
progress 100
