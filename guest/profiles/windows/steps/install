#!/usr/bin/env bash
# Installs Windows unattended: stages the answer-file disc, boots the installer with it as the
# second CD, and waits until the guest has provisioned itself at first logon (its agent answers and
# its done marker exists). Idempotent: a guest that is already running is waited for, never wiped.
set -uo pipefail
# shellcheck source=lib/windows.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/windows.sh"

GUARD_S=${INSTALL_GUARD_SECONDS:-7200}
POLL_S=${INSTALL_POLL_SECONDS:-15}
KEY_PRESSES=${INSTALL_KEY_PRESSES:-20}
KEY_INTERVAL_S=${INSTALL_KEY_INTERVAL:-1}
SETUP_STARTED_BYTES=${INSTALL_START_BYTES:-524288000}
SETUP_START_CHECK_S=${INSTALL_START_CHECK:-180}
SETUP_START_ATTEMPTS=${INSTALL_START_ATTEMPTS:-3}
TYPICAL_INSTALL_S=${INSTALL_TYPICAL_SECONDS:-900}
# Setup copies the image, reboots a few times and runs OOBE before the first logon starts
# provision.ps1; there is no cheap signal for "the desktop is up", so the agent gets that long, plus
# the grace period, before its silence is blamed on the first-logon command (F2).
SETUP_ALLOWANCE_S=${INSTALL_SETUP_ALLOWANCE_SECONDS:-1800}
AGENT_GRACE_S=${INSTALL_AGENT_GRACE_SECONDS:-900}
MINUTE_S=${INSTALL_MINUTE_SECONDS:-60}
AGENT_SCRIPT=${TT_AGENT_SCRIPT:-/opt/CAPEv2/agent/agent.py}
STAGING=$TT_BUILD_DIR/answer-files
ANSWER_ISO=$TT_BUILD_DIR/answer.iso
PROVISION_FILES=(provision.ps1 defender-settings.ps1 decoys.ps1 sysmon-config.xml)
WAIT_PROGRESS_FROM=10
WAIT_PROGRESS_TO=95
# Before the guest's own log can be read the percentage is a guess; it stays in the lower part of
# the band so the real one, steps done over steps planned, can still move it.
ESTIMATE_PROGRESS_TO=20

DONE_MARKER=$(profile_name done_marker)
LOG_NAME=$(profile_name log_file)
marker_present() { guest_agent exists "$DONE_MARKER"; }
provisioned() { agent_answers && marker_present; }

stage_payload() {
    local entries entry name
    mapfile -t entries < <(grep -vE '^[[:space:]]*(#|$)' "$TT_PROFILE_DIR/manifest.sha256")
    for entry in "${entries[@]}"; do
        read -r _ name _ <<<"$entry"
        [[ -f $CACHE_DIR/$name ]] || fail "$name is not in the download cache; the fetch step has to run first"
        cp "$CACHE_DIR/$name" "$STAGING/payload/$name" || fail "could not copy $name"
    done
    [[ -f $AGENT_SCRIPT ]] || fail "the guest agent script is missing: $AGENT_SCRIPT"
    cp "$AGENT_SCRIPT" "$STAGING/payload/agent.py" || fail "could not copy agent.py"
}

stage_answer_files() {
    local file
    rm -rf "$STAGING"
    install -d -m 700 "$STAGING" "$STAGING/provision" "$STAGING/payload"
    python3 -I "$WINDOWS_STEPS_LIB/render_unattend.py" "$STAGING/autounattend.xml" "$STAGING/provision/parameters.json" \
        || fail "could not render the answer file"
    for file in "${PROVISION_FILES[@]}"; do
        cp "$TT_PROFILE_DIR/$file" "$STAGING/provision/$file" || fail "could not copy $file"
    done
    stage_payload
    : >"$STAGING/$(profile_name cd_marker_file)"
}

# The staging folder holds the answer file with the account password in it; the disc is all that stays,
# owner-only: libvirt gives the file to QEMU's user when the guest starts. It cannot be deleted after the
# install, because the install domain stays defined with it as a CD for every later restart.
build_answer_iso() {
    local label
    label=$(profile_name cd_volume_label)
    rm -f "$ANSWER_ISO"
    if ! (umask 077 && xorriso -as mkisofs -quiet -V "$label" -J -joliet-long -r -o "$ANSWER_ISO" "$STAGING"); then
        rm -rf "$STAGING"
        fail "could not build the answer-file ISO"
    fi
    rm -rf "$STAGING"
}

boot_installer() {
    render_domain install --media "$MEDIA_PATH" --extra-media "$ANSWER_ISO"
    define_rendered install
    vsh start "$GUEST_NAME" >/dev/null || fail "the guest did not start"
}

# Microsoft's UEFI media shows "Press any key to boot from CD" for about five seconds, a second or
# two after power-on; without a key the firmware falls through to the empty disk. Stop well before
# Setup's window appears: its focused button is Cancel, and a stray Enter there opens an exit
# dialog. Only the first boot is nudged; after Setup's own reboot the prompt times out and the
# installed disk boots.
dismiss_press_any_key() {
    local press
    for ((press = 0; press < KEY_PRESSES; press++)); do
        vsh send-key "$GUEST_NAME" KEY_ENTER >/dev/null 2>&1
        sleep "$KEY_INTERVAL_S"
    done
}

disk_bytes_used() { stat -c '%b %B' "$DISK_PATH" 2>/dev/null | awk '{print $1 * $2}' | grep . || echo 0; }

# Setup copies the image onto the blank disk within minutes, so a disk that stays nearly empty means
# the boot prompt was missed (its window is short and its timing varies with the firmware).
setup_is_writing() { (($(disk_bytes_used) >= SETUP_STARTED_BYTES)); }

boot_until_setup_is_writing() {
    local attempt
    for ((attempt = 1; attempt <= SETUP_START_ATTEMPTS; attempt++)); do
        dismiss_press_any_key
        wait_for "$SETUP_START_CHECK_S" 5 setup_is_writing && return 0
        ((attempt < SETUP_START_ATTEMPTS)) || break
        log "Setup has not started writing to the disk (attempt $attempt of $SETUP_START_ATTEMPTS); resetting the guest to catch the boot prompt again"
        vsh reset "$GUEST_NAME" >/dev/null 2>&1
    done
    fail "Setup has not started writing to the disk after $SETUP_START_ATTEMPTS boot attempts; look at the guest's screen"
}

WAIT_STARTED=$SECONDS
WAIT_MINUTES_LOGGED=0
WAIT_PERCENT_SHOWN=0
GUEST_STEP_SHOWN=""

show_percent() {
    if (($1 > WAIT_PERCENT_SHOWN)); then
        WAIT_PERCENT_SHOWN=$1
        progress "$1"
    fi
}

report_estimate() {
    local elapsed=$((SECONDS - WAIT_STARTED)) minutes
    show_percent $((WAIT_PROGRESS_FROM + (ESTIMATE_PROGRESS_TO - WAIT_PROGRESS_FROM) * elapsed / TYPICAL_INSTALL_S))
    minutes=$((elapsed / MINUTE_S))
    if ((minutes > WAIT_MINUTES_LOGGED)); then
        WAIT_MINUTES_LOGGED=$minutes
        log "Windows is installing, $minutes min elapsed; the bar is an estimate until the guest reports its own steps"
    fi
}

report_guest_progress() {
    local plan steps_done current
    plan=$(guest_log_plan)
    current=$(guest_log_current_step)
    if [[ -n $current && $current != "$GUEST_STEP_SHOWN" ]]; then
        GUEST_STEP_SHOWN=$current
        step "Windows is provisioning itself: $current"
    fi
    ((plan > 0)) || return 0
    steps_done=$(guest_log_steps_done)
    ((steps_done <= plan)) || steps_done=$plan
    show_percent $((WAIT_PROGRESS_FROM + (WAIT_PROGRESS_TO - WAIT_PROGRESS_FROM) * steps_done / plan))
}

# The marker is checked before the log is read: it is written after the final log line, so a marker
# seen first and a log read second cannot miss a line.
relay_guest_log() {
    fetch_guest_log_lines "$LOG_NAME" || return 0
    show_new_guest_log_lines
    report_guest_progress
}

agent_has_been_silent_too_long() { ((SECONDS - WAIT_STARTED > SETUP_ALLOWANCE_S + AGENT_GRACE_S)); }

# provision.ps1 starts the agent early, so the agent answering means provisioning is under way; only
# the done marker, its last act, means it finished.
provisioning_poll() {
    domain_running || fail "the guest stopped (it is $(domain_state)) before provisioning finished; look at its console"
    if agent_answers; then
        local finished=1
        marker_present || finished=0
        relay_guest_log
        ((finished)) && return 0
        return 1
    fi
    agent_has_been_silent_too_long && fail "Windows is installed but the guest never started its provisioning; the first-logon command did not run"
    report_estimate
    return 1
}

wait_for_provisioning() {
    WAIT_STARTED=$SECONDS
    wait_for "$GUARD_S" "$POLL_S" provisioning_poll || fail "provisioning did not finish within ${GUARD_S}s"
}

step "Installing Windows"
progress 1
[[ -n $MEDIA_PATH ]] || fail "the guest record names no installation medium"
if domain_running; then
    if provisioned; then
        progress 100
        log "provisioning had already finished"
        exit 0
    fi
    log "the guest is already running; waiting for it instead of starting the installation again"
else
    stage_answer_files
    progress 5
    build_answer_iso
    progress 8
    boot_installer
    progress "$WAIT_PROGRESS_FROM"
    boot_until_setup_is_writing
fi
wait_for_provisioning
progress 100
log "Windows is installed and has provisioned itself"
